# Copy to .env and fill in. Never commit .env.
# Gmail needs 2-Step Verification on, then an app password from https://myaccount.google.com/apppasswords
TRACKER_EMAIL_USER=you@gmail.com
TRACKER_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Optional. Defaults to TRACKER_EMAIL_USER.
# TRACKER_EMAIL_TO=you@gmail.com
# Optional. Defaults shown.
# TRACKER_SMTP_HOST=smtp.gmail.com
# TRACKER_SMTP_PORT=465
